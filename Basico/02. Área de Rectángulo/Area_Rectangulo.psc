Algoritmo Area_Rectangulo
	//Definir las variables
	definir area, base, altura Como Real;
	
	//Ingresar la base del rectangulo
	Escribir "Ingrese la Base del rectangulo en cm: ";
	Leer base;
	
	//Ingresar la altura del rectangulo
	Escribir "Ingrese la Altura del rectangulo en cm: ";
	Leer altura;
	
	//Opracion para calcular el area 
	area <- base * altura;
	
	//Mostrar en pantalla el resultado de la opracion
	Escribir "El area del rectangulo es de: ", area, "cm^2";
FinAlgoritmo
